user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

stream {
    map $ssl_preread_server_name $port {
        # if connecting to signal proxy, forward internally to port 4432
        signal.{{ domain_name }} 4432;

        # otherwise, forward to apache on port 4431 without terminating TLS
        default 4431;
    }

    server {
        listen 443;
        ssl_preread on;
        proxy_pass 127.0.0.1:$port;
    }

    # terminate TLS and forward to signal relay on port 4433
    server {
        listen 4432 ssl;
        proxy_pass 127.0.0.1:4433;
        include /etc/letsencrypt/options-ssl-nginx.conf;
    }
}
