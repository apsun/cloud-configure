<VirtualHost *:*>
        ServerName nitter.{{ domain_name }}

        ProxyPreserveHost On
        ProxyPass "/" "http://127.0.0.1:8389/" nocanon
        ProxyPassReverse "/" "http://127.0.0.1:8389/"
        AllowEncodedSlashes On

        Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
