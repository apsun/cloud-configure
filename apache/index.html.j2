<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ hostname }}</title>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: sans-serif;
            font-size: x-large;
        }

        #wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100%;
        }

        #content {
            padding: 16px;
        }
    </style>
</head>
<body>
    <div id="wrapper">
        <div id="content">
            <a href="//fish.{{ domain_name }}/">fish (file upload service)</a><br>
            <a href="//clips.{{ domain_name }}/">clips (web pasteboard)</a><br>
            <a href="//gastrak.{{ domain_name }}/">gastrak (costco gasoline prices)</a><br>
            <a href="//nitter.{{ domain_name }}/">nitter (twitter frontend)</a><br>
        </div>
    </div>
</body>
</html>
